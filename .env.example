# AI consistency check through the Astropods gateway. Leave the key empty to run in demo mode with saved results
# for the sample order.
ASTRO_GATEWAY_URL=https://aig.astropods.ai
ASTRO_MODEL=qwen3-vl
ASTRO_GATEWAY_API_KEY=
# Optional alternative when the gateway key is empty: Claude directly.
ANTHROPIC_API_KEY=

# PayPal sandbox REST app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from the sandbox app's Webhooks section (events: PAYMENT.AUTHORIZATION.CREATED/VOIDED,
# PAYMENT.CAPTURE.COMPLETED/DENIED), pointing at <APP_BASE_URL>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Same client ID, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Public base URL used in links sent to customers
APP_BASE_URL=http://localhost:3000
